# =============================================================================
# Airepro Agent Training Portal — production
# Domains: training.airepro.in (SPA) · training-s.airepro.in (API)
# Host publish: 127.0.0.1:1918 (FE) · 127.0.0.1:1919 (API)
# Replace REPLACE_ME secrets before deploy (Jenkins: ~/.secrets/airepro-training.env).
# =============================================================================

NODE_ENV=production

# --- Domains -----------------------------------------------------------------
DOMAIN=training.airepro.in
BACKEND_DOMAIN=training-s.airepro.in

FRONTEND_PORT=1918
BACKEND_PORT=1919

# --- Frontend build (baked into SPA image) -----------------------------------
VITE_API_BASE_URL=https://training-s.airepro.in

# --- Backend runtime ---------------------------------------------------------
HOST=0.0.0.0
PORT=8787
SERVE_FRONTEND=false
CORS_ORIGIN=https://training.airepro.in

# --- Auth (demo accounts for early production access; switch to obo later) ---
AUTH_MODE=demo
# When ready for OBO-only:
# AUTH_MODE=obo
OBO_API_BASE_URL=https://oboserver.airepro.in/api/v1

# Session signing — set a long random value in Jenkins secrets / deploy env
TRAINING_JWT_SECRET=REPLACE_ME_with_long_random_string
ADMIN_TOKEN_SECRET=REPLACE_ME_with_long_random_string
# Optional legacy; unused by portal OBO login
ADMIN_PASSWORD=REPLACE_ME

# --- Database (Docker volume /app/data) --------------------------------------
TRAINING_DB_PATH=/app/data/training.sqlite
