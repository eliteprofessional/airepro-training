# =============================================================================
# Airepro Training — deployment env
# Copy to .env and replace REPLACE_ME / change-me values before deploy.
# Docker Compose: loads this file automatically.
# Jenkins agent secrets: copy ADMIN_* (and any overrides) to
#   /var/lib/jenkins/.secrets/airepro-training.env
# =============================================================================

# --- Domains (public URLs) ---------------------------------------------------
# Frontend SPA (browser)
DOMAIN=training.airepro.in
# Backend API (browser + CORS)
BACKEND_DOMAIN=training-s.airepro.in

# --- Host ports (Cloudflare Tunnel / reverse proxy targets) ------------------
# training.airepro.in  → 127.0.0.1:FRONTEND_PORT
FRONTEND_PORT=410
# training-s.airepro.in → 127.0.0.1:BACKEND_PORT
BACKEND_PORT=1411

# --- Frontend build (baked into SPA image) -----------------------------------
# Must be the public API origin users' browsers call
VITE_API_BASE_URL=https://training-s.airepro.in

# --- Backend runtime ---------------------------------------------------------
HOST=0.0.0.0
PORT=8787
# false = split FE/BE containers (production). true = all-in-one image only.
SERVE_FRONTEND=false
# Allowed SPA origin(s), comma-separated if multiple
CORS_ORIGIN=https://training.airepro.in

# --- Admin auth (REQUIRED — replace before any real deploy) ------------------
ADMIN_PASSWORD=REPLACE_ME
ADMIN_TOKEN_SECRET=REPLACE_ME_with_long_random_string
