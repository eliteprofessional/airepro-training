# =============================================================================
# Airepro Agent Training Portal — environment
# Copy to .env and replace REPLACE_ME values before deploy.
# =============================================================================

# --- Domains (public URLs; never hard-code only in app code) -----------------
DOMAIN=training.airepro.in
BACKEND_DOMAIN=training-s.airepro.in
# Staging examples:
# DOMAIN=training-staging.airepro.in
# BACKEND_DOMAIN=training-s-staging.airepro.in

FRONTEND_PORT=410
BACKEND_PORT=1411

VITE_API_BASE_URL=https://training-s.airepro.in
# Staging: VITE_API_BASE_URL=https://training-s-staging.airepro.in

HOST=0.0.0.0
PORT=8787
SERVE_FRONTEND=false
CORS_ORIGIN=https://training.airepro.in
# Staging: CORS_ORIGIN=https://training-staging.airepro.in

# --- Auth --------------------------------------------------------------------
# demo = seeded local users (default for local/dev)
# obo  = proxy login to OBO_API_BASE_URL POST /auth/login
AUTH_MODE=demo
OBO_API_BASE_URL=http://localhost:8082/api/v1
# Stage example: OBO_API_BASE_URL=https://obo-api-stage.example/api/v1

TRAINING_JWT_SECRET=REPLACE_ME_with_long_random_string
# Legacy alias still accepted:
ADMIN_TOKEN_SECRET=REPLACE_ME_with_long_random_string
# Optional shared-password leftover (unused by portal login):
ADMIN_PASSWORD=REPLACE_ME

# --- Database ----------------------------------------------------------------
# SQLite path (relative to project root or absolute). Docker volume mounts /app/data
TRAINING_DB_PATH=data/training.sqlite
